# Copy this file to .env (for local builds) and fill in your values.
# The GitHub Actions workflow sets these automatically for official builds.

# URL of the update manifest (updates.json). GitHub Releases works well:
VITE_UPDATE_MANIFEST_URL=https://github.com/OWNER/REPO/releases/latest/download/updates.json

# Where the in-app feedback form sends messages.
VITE_FEEDBACK_EMAIL=admin@rhemanigeria.com

# Optional: POST feedback JSON to this URL (for example a Formspree endpoint).
# When set, the app uses this instead of opening the user's email app.
# VITE_FEEDBACK_ENDPOINT=https://formspree.io/f/xxxxxxxx
